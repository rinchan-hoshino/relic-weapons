{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.rinchan.relicweapons.fabric.RelicWeaponsFabric"],
    "client": ["dev.rinchan.relicweapons.fabric.RelicWeaponsFabricClient"]
  },
  "mixins": [
    "relic_weapons.mixins.json",
    "relic_weapons.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "contact": {
    "homepage": "https://modrinth.com/mod/relic-weapons",
    "sources": "https://github.com/rinchan-hoshino/relic-weapons",
    "issues": "https://github.com/rinchan-hoshino/relic-weapons/issues"
  }
}
